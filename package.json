{
  "name": "typeloop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node scripts/run-node-tests.mjs unit",
    "test:integration": "node scripts/run-node-tests.mjs integration",
    "test:coverage": "node scripts/run-node-tests.mjs coverage",
    "test:e2e": "npm run test:e2e:flows && npm run test:e2e:performance",
    "test:e2e:flows": "playwright test --grep-invert @performance",
    "test:e2e:performance": "playwright test --grep @performance --project=chromium --workers=1",
    "test:domain": "node --experimental-strip-types --test src/domain/**/*.test.ts",
    "test:architecture": "node --test tests/architecture-boundaries.test.mjs tests/repository-conventions.test.mjs",
    "e2e:install": "playwright install chromium webkit",
    "import:consulting": "python3 scripts/import_consulting_playbook.py",
    "import:takken": "node scripts/import_takken_glossary.mjs",
    "import:git": "node scripts/import_git_commands.mjs",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.check.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check:dead-code": "knip",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:deps": "node scripts/check-dependency-compatibility.mjs",
    "check:generated": "node scripts/import_git_commands.mjs --check && node scripts/import_takken_glossary.mjs --check && node scripts/generate-browser-theme-colors.mjs --check",
    "check:content": "node --experimental-strip-types scripts/check-takken-governance.mjs",
    "check:privacy": "node scripts/check-public-content.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:static": "node scripts/check-static-routes.mjs",
    "verify:production": "node scripts/verify-production-release.mjs",
    "check:security": "npm run check:secrets && npm run audit:dependencies",
    "audit:dependencies": "npm audit --audit-level=high",
    "check:quick": "npm run format:check && npm run check:generated && npm run check:content && npm run check:privacy && npm run check:tokens && npm run lint && npm run typecheck && npm run test",
    "check": "npm run format:check && npm run check:generated && npm run check:content && npm run check:privacy && npm run check:tokens && npm run lint && npm run typecheck && npm run test:coverage && npm run check:dead-code && npm run build && npm run check:static && npm run check:bundle && npm run test:e2e",
    "check:ci": "npm run check:deps && npm run check && npm run check:security"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "c8": "12.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "knip": "6.33.0",
    "prettier": "3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "yaml": "2.9.0"
  },
  "type": "module"
}
