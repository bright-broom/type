{
  "name": "typeloop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node scripts/run-node-tests.mjs unit",
    "test:integration": "node scripts/run-node-tests.mjs integration",
    "test:coverage": "node scripts/run-node-tests.mjs coverage",
    "test:e2e": "playwright test",
    "test:domain": "node --experimental-strip-types --test src/domain/**/*.test.ts",
    "test:architecture": "node --test tests/architecture-boundaries.test.mjs tests/repository-conventions.test.mjs",
    "e2e:install": "playwright install chromium",
    "import:consulting": "python3 scripts/import_consulting_playbook.py",
    "import:takken": "node scripts/import_takken_glossary.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check:dead-code": "knip",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:security": "npm run check:secrets && npm run audit:dependencies",
    "audit:dependencies": "npm audit --audit-level=high",
    "check:quick": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run check:dead-code && npm run build && npm run test:e2e",
    "check:ci": "npm run check && npm run check:security"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "c8": "12.0.0",
    "eslint": "10.8.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "type": "module"
}
